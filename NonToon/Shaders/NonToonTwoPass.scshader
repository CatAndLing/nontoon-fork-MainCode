Shader "NonToonTwoPass"
// ⚠️ 本文件由 tools/make-twopass.mjs 从 NonToon.scshader **生成**，请勿手改。
//    重跑：node tools/make-twopass.mjs
//    （上面那行 `Shader "NonToonTwoPass"` 必须是本文件第一行 —— ShaderCore 的正则没有 Multiline。）
//
// 为什么需要这个变体（[NT-FEAT 26] 两趟透明）：
//   lilToon 的 TwoPass 透明（Hidden/lilToonTwoPassTransparentOutline）用 **两个 pass**
//   —— FORWARD_BACK（Cull [_PreCull] / ZWrite [_PreZWrite]）→ FORWARD（Cull [_Cull] / ZWrite [_ZWrite]）。
//   两遍在同深度处都能通过 ZTest LEqual ⇒ **同一像素混合两次**，有效不透明度 ≈ 1-(1-a)^2。
//   这对「半透明包装袋 ↔ 袋内内容物」的遮挡/透视关系是必需的：
//   实测（辉夜模型的 aburaage_open 油揚げ包装袋）单趟时黑布会渲染成灰白幽灵、袋体发虚。
//   已实测否掉便宜替代：把 _ZWrite 改成 0（黑布回来但过深、且多出灰色晕圈）。
//
// 为什么是**独立变体**而不是给主着色器加一个常驻 pass：
//   ShaderLab 无法按材质属性条件编译掉整个 Pass ⇒ 常驻 pass 会给**每个** NonToon 材质
//   多一次 draw call。独立变体让只有需要的材质付这个代价，符合本包「默认零开销」原则；
//   这也与 lilToon 同构 —— 它本来就是靠**专用变体着色器**表达渲染模式的。
//
// 模块登记是**自动**的：ShaderCore 的 ProjectSettings.GetShaderModules() 会在本文件所在目录
// 扫 *.scmodule（shadercore/Editor/ProjectSettings.cs:28）⇒ 本变体自动获得与 NonToon 相同的模块集。
//
// 上游依据：lilToon 的 lts.shader / lts_onetrans.shader / lts_twotrans.shader 等变体；
//           NonToon 上游 13 条 issue 中**没有任何一条涉及 TwoPass** ⇒ 这是 fork 自研能力。


{
    Properties
    {
        __SC_SHADERLAB_properties__

        // Integer型だと動かないのでIntを使用
        [SCModule()][SCFoldout(__Stencil)]
            [SCBox]
            [SCRangeInt(0,255)]                             _StencilRef  ("Ref", Int) = 0
            [SCEnum(UnityEngine.Rendering.CompareFunction)] _StencilComp ("Comp", Int) = 8
            [SCEnum(UnityEngine.Rendering.StencilOp)]       _StencilPass ("Pass", Int) = 0
            [SCBoxEnd]

            [SCBox]
            [SCRangeInt(0,255)]                             _OutlineStencilRef  ("Outline Ref", Int) = 0
            [SCEnum(UnityEngine.Rendering.CompareFunction)] _OutlineStencilComp ("Outline Comp", Int) = 8
            [SCEnum(UnityEngine.Rendering.StencilOp)]       _OutlineStencilPass ("Outline Pass", Int) = 0
            [SCBoxEnd]
        [SCFoldoutEnd]

        [SCFoldout(__Rendering)]
            [SCBox]
            [SCEnum(Off, 0, Front, 1, Back, 2)]       _Cull            ("Cull", Int) = 2
            [SCEnum(UnityEngine.Rendering.BlendMode)] _SrcBlend        ("SrcBlendRGB", Int) = 1
            [SCEnum(UnityEngine.Rendering.BlendMode)] _DstBlend        ("DstBlendRGB", Int) = 0
            [SCEnum(UnityEngine.Rendering.BlendMode)] _SrcBlendAlpha   ("SrcBlendAlpha", Int) = 1
            [SCEnum(UnityEngine.Rendering.BlendMode)] _DstBlendAlpha   ("DstBlendAlpha", Int) = 10
            [SCEnum(UnityEngine.Rendering.BlendMode)] _SrcBlendFA      ("SrcBlendRGB ForwardAdd", Int) = 1
            [SCEnum(UnityEngine.Rendering.BlendMode)] _DstBlendFA      ("DstBlendRGB ForwardAdd", Int) = 1
            [SCEnum(UnityEngine.Rendering.BlendMode)] _SrcBlendAlphaFA ("SrcBlendAlpha ForwardAdd", Int) = 0
            [SCEnum(UnityEngine.Rendering.BlendMode)] _DstBlendAlphaFA ("DstBlendAlpha ForwardAdd", Int) = 1
            [SCToggle]                                _ZWrite          ("ZWrite", Int) = 1
            [SCToggle]                                _AlphaToMask     ("AlphaToMask", Int) = 0
            [SCToggle]                                _PreZWrite       ("PrePass ZWrite", Int) = 0
            [SCEnum(Off, 0, Front, 1, Back, 2)]       _PreCull         ("PrePass Cull", Int) = 2
            [SCEnum(UnityEngine.Rendering.BlendMode)] _PreSrcBlend     ("PrePass SrcBlendRGB", Int) = 0
            [SCEnum(UnityEngine.Rendering.BlendMode)] _PreDstBlend     ("PrePass DstBlendRGB", Int) = 1
            [SCBoxEnd]

            _OutlineOffsetFactor ("Outline Offset Factor", Float) = 0
            _OutlineOffsetUnits  ("Outline Offset Units", Float) = 0
        [SCFoldoutEnd]

        [HideInInspector]_LTCGI("",Int) = 0
    }

    HLSLINCLUDE
    // intまたはuintプロパティがあるとVulkanでコンパイルに失敗
    #pragma skip_variants DOTS_INSTANCING_ON
    __SC_SHADERKEYWORDS__
    ENDHLSL

    SubShader
    {
        PackageRequirements
        {
            "com.unity.render-pipelines.universal": "17.0"
        }

        Tags
        {
            "RenderType" = "Opaque"
            "RenderPipeline" = "UniversalPipeline"
            "UniversalMaterialType" = "Lit"
            "IgnoreProjector" = "True"
        }

        Pass
        {
            Name "ForwardBack"
            Tags { "LightMode" = "UniversalForward" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull [_PreCull]
            ZWrite [_PreZWrite]
            Blend [_PreSrcBlend] [_PreDstBlend], [_SrcBlendAlpha] [_DstBlendAlpha]

            HLSLPROGRAM
            #pragma target 5.0
            // ★ 与 lilToon 的 LIL_TRANSPARENT_PRE 同构：**只在本 pass 里**定义，
            //   让 sc_common.hlsl / urp.hlsl / birp.hlsl 的透明分支改走"背面趟"语义
            //   （乘 _PreColor + 用**自己的** _PreCutoff 裁剪，而不是 _Cutoff）。
            //   没有这一条，本 pass 就等于把 Forward 原样画第二遍 —— 实测混合量会多出近一倍
            //   （"第二次混合落地率" 0.80 vs lilToon 的 0.43）。
            #define NT_FORWARDBACK
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_forward.hlsl"
            #include "urp.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "Forward"
            Tags { "LightMode" = "UniversalForward" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull [_Cull]
            ZWrite [_ZWrite]
            Blend [_SrcBlend] [_DstBlend], [_SrcBlendAlpha] [_DstBlendAlpha]
            AlphaToMask [_AlphaToMask]

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_forward.hlsl"
            #include "urp.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "Outline"
            Tags { "LightMode" = "UniversalForwardOnly" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull Front
            Offset [_OutlineOffsetFactor], [_OutlineOffsetUnits]
            ZWrite [_ZWrite]
            Blend [_SrcBlend] [_DstBlend], [_SrcBlendAlpha] [_DstBlendAlpha]
            AlphaToMask [_AlphaToMask]

            HLSLPROGRAM
            #pragma target 5.0
            #define OUTLINE
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_forward.hlsl"
            #include "urp.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "ShadowCaster"
            Tags { "LightMode" = "ShadowCaster" }
            ZWrite On
            ZTest LEqual
            ColorMask 0
            Cull [_Cull]

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_shadowcaster.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "DepthOnly"
            Tags { "LightMode" = "DepthOnly" }
            ZWrite On
            ColorMask R
            Cull [_Cull]

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_depthonly.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "DepthNormals"
            Tags { "LightMode" = "DepthNormals" }
            ZWrite On
            Cull [_Cull]

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_depthnormals.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "MotionVectors"
            Tags { "LightMode" = "MotionVectors" }
            ColorMask RG
            Cull [_Cull]

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_xrmotionvectors.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "XRMotionVectors"
            Tags { "LightMode" = "XRMotionVectors" }
            ColorMask RGBA
            Cull [_Cull]

            Stencil
            {
                WriteMask 1
                Ref 1
                Comp Always
                Pass Replace
            }

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp_xrmotionvectors.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "Meta"
            Tags { "LightMode" = "Meta" }
            Cull Off

            HLSLPROGRAM
            #pragma target 2.0
            #pragma vertex UniversalVertexMeta
            #pragma fragment UniversalFragmentMetaLit

            #pragma shader_feature EDITOR_VISUALIZATION

            #define _BaseMap_ST float4(1,1,0,0)

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/UniversalMetaPass.hlsl"
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/urp.hlsl"

            __SC_URP_properties__

            half4 UniversalFragmentMetaLit(Varyings input) : SV_Target
            {
                MetaInput metaInput;
                metaInput.Albedo = SCSample(_BaseTexture, sampler_BaseTexture, input.uv).rgb;
                metaInput.Emission = 0;
                return UniversalFragmentMeta(input, metaInput);
            }

            ENDHLSL
        }
    }

    SubShader
    {
        Tags
        {
            "RenderType" = "Opaque"
            "RenderPipeline" = ""
            "LTCGI" = "_LTCGI"
        }

        Pass
        {
            Name "ForwardBack"
            Tags { "LightMode" = "ForwardBase" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull [_PreCull]
            ZWrite [_PreZWrite]
            Blend [_PreSrcBlend] [_PreDstBlend], [_SrcBlendAlpha] [_DstBlendAlpha]

            HLSLPROGRAM
            #pragma target 5.0
            // ★ 与 lilToon 的 LIL_TRANSPARENT_PRE 同构：**只在本 pass 里**定义，
            //   让 sc_common.hlsl / urp.hlsl / birp.hlsl 的透明分支改走"背面趟"语义
            //   （乘 _PreColor + 用**自己的** _PreCutoff 裁剪，而不是 _Cutoff）。
            //   没有这一条，本 pass 就等于把 Forward 原样画第二遍 —— 实测混合量会多出近一倍
            //   （"第二次混合落地率" 0.80 vs lilToon 的 0.43）。
            #define NT_FORWARDBACK
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forward.hlsl"
            #include "birp.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "Forward"
            Tags { "LightMode" = "ForwardBase" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull [_Cull]
            ZWrite [_ZWrite]
            Blend [_SrcBlend] [_DstBlend], [_SrcBlendAlpha] [_DstBlendAlpha]
            AlphaToMask [_AlphaToMask]

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forward.hlsl"
            #include "birp.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "ForwardAdd"
            Tags { "LightMode" = "ForwardAdd" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull [_Cull]
            ZWrite Off
            Blend SrcAlpha One, Zero One
            AlphaToMask [_AlphaToMask]

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forwardadd.hlsl"
            #include "birp.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "Outline"
            Tags { "LightMode" = "ForwardBase" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull Front
            Offset [_OutlineOffsetFactor], [_OutlineOffsetUnits]
            ZWrite [_ZWrite]
            Blend [_SrcBlend] [_DstBlend], [_SrcBlendAlpha] [_DstBlendAlpha]
            AlphaToMask [_AlphaToMask]

            HLSLPROGRAM
            #pragma target 5.0
            #define OUTLINE
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forward.hlsl"
            #include "birp.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "OutlineAdd"
            Tags { "LightMode" = "ForwardAdd" }

            Stencil
            {
                Ref [_StencilRef]
                Comp [_StencilComp]
                Pass [_StencilPass]
            }
            Cull Front
            Offset [_OutlineOffsetFactor], [_OutlineOffsetUnits]
            ZWrite Off
            Blend SrcAlpha One, Zero One
            AlphaToMask [_AlphaToMask]

            HLSLPROGRAM
            #pragma target 5.0
            #define OUTLINE
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_forwardadd.hlsl"
            #include "birp.hlsl"
            ENDHLSL
        }

        Pass {
            Name "ShadowCaster"
            Tags { "LightMode" = "ShadowCaster" }

            Cull [_Cull]
            ZWrite On
            ZTest LEqual

            HLSLPROGRAM
            #pragma target 5.0
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp_shadowcaster.hlsl"
            ENDHLSL
        }

        Pass
        {
            Name "Meta"
            Tags { "LightMode" = "Meta" }
            Cull Off

            HLSLPROGRAM
            #pragma target 2.0
            
            #pragma vertex vert
            #pragma fragment frag

            #pragma shader_feature EDITOR_VISUALIZATION
            #include "UnityCG.cginc"
            #include "UnityMetaPass.cginc"
            #include "Packages/jp.lilxyzw.shadercore/ShaderLibrary/birp.hlsl"

            __SC_BIRP_properties__

            struct appdata
            {
                float4 vertex   : POSITION;
                float2 uv0      : TEXCOORD0;
                float2 uv1      : TEXCOORD1;
                float2 uv2      : TEXCOORD2;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct v2f_meta
            {
                float4 pos      : SV_POSITION;
                float2 uv       : TEXCOORD0;
                #ifdef EDITOR_VISUALIZATION
                float2 vizUV        : TEXCOORD1;
                float4 lightCoord   : TEXCOORD2;
                #endif
            };

            v2f_meta vert(appdata v)
            {
                v2f_meta o;
                o.pos = UnityMetaVertexPosition(v.vertex, v.uv1.xy, v.uv2.xy, unity_LightmapST, unity_DynamicLightmapST);
                o.uv = v.uv0;
                #ifdef EDITOR_VISUALIZATION
                o.vizUV = 0;
                o.lightCoord = 0;
                if (unity_VisualizationMode == EDITORVIZ_TEXTURE)
                    o.vizUV = UnityMetaVizUV(unity_EditorViz_UVIndex, v.uv0.xy, v.uv1.xy, v.uv2.xy, unity_EditorViz_Texture_ST);
                else if (unity_VisualizationMode == EDITORVIZ_SHOWLIGHTMASK)
                {
                    o.vizUV = v.uv1.xy * unity_LightmapST.xy + unity_LightmapST.zw;
                    o.lightCoord = mul(unity_EditorViz_WorldToLight, mul(unity_ObjectToWorld, float4(v.vertex.xyz, 1)));
                }
                #endif
                return o;
            }

            float4 frag(v2f_meta i) : SV_Target
            {
                UnityMetaInput o;
                UNITY_INITIALIZE_OUTPUT(UnityMetaInput, o);

                o.Albedo = SCSample(_BaseTexture, sampler_BaseTexture, i.uv).rgb;
                #ifdef EDITOR_VISUALIZATION
                o.VizUV = i.vizUV;
                o.LightCoord = i.lightCoord;
                #endif
                o.SpecularColor = 0;
                o.Emission = 0;

                return UnityMetaFragment(o);
            }
            ENDHLSL
        }
    }
    CustomEditor "SCMaterialEditor"
}
