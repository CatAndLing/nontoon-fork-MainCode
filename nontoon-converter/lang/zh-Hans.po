msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh-Hans\n"

# ============================================================
# [NT-L10N] 工具包（转换器 + 自阴影组件）简体中文翻译表
#
# key   = C# 里保留的英文原文
# value = 显示用的中文；未命中的 key 会原样显示英文（英文 fallback）
#
# 注意：值里不要出现英文双引号，也不要出现反斜杠转义（POParser 是简单实现）。
# 带 {0} {1} 的是 string.Format 模板。
# ============================================================

# ---- 报告 / 日志 ----
msgid "lilToon to NonToon Converter report"
msgstr "lilToon → NonToon 转换报告"

msgid "Converter version: "
msgstr "转换器版本："

msgid "Generated: "
msgstr "生成时间："

msgid "Target NonToon: "
msgstr "目标 NonToon："

msgid "Target Shader Core: "
msgstr "目标 Shader Core："

msgid "Installed packages: NonToon "
msgstr "已安装：NonToon "

msgid ", Shader Core "
msgstr "，Shader Core "

msgid "Success: {0}, Warnings: {1}, Unsupported: {2}, Errors: {3}"
msgstr "成功 {0} / 警告 {1} / 不支持 {2} / 错误 {3}"

msgid "  Output: "
msgstr "  输出："

msgid "Success"
msgstr "成功"

msgid "Warning"
msgstr "警告"

msgid "Unsupported"
msgstr "不支持"

msgid "Error"
msgstr "错误"

# ---- 安装状态 ----
msgid "not found"
msgstr "未安装"

msgid "NonToon {0} (target {1}), Shader Core {2} (target {3})"
msgstr "NonToon {0}（目标 {1}），Shader Core {2}（目标 {3}）"

msgid "NonToon and/or NonToonFur shader was not found. Install NonToon {0} and Shader Core {1} through VPM."
msgstr "找不到 NonToon 与/或 NonToonFur 着色器。请先通过 VPM 安装 NonToon {0} 与 Shader Core {1}。"

msgid "NonToon core and detected modules are available. "
msgstr "NonToon 本体与检测到的模块都可用。"

msgid "The shaders are available, but the installed versions are older than the tested target. "
msgstr "着色器可用，但已安装版本低于本转换器测试过的目标版本。"

msgid "Missing NonToon modules: "
msgstr "缺少 NonToon 模块："

msgid ". Related features will be reported and skipped."
msgstr "。相关功能会被报告并跳过。"

msgid "NonToon or NonToonFur was not found. Install NonToon {0} and Shader Core {1} through VPM first."
msgstr "找不到 NonToon 或 NonToonFur。请先通过 VPM 安装 NonToon {0} 与 Shader Core {1}。"

msgid "WARNING: Installed package versions are older than the tested target. {0}. Update through VPM, then convert again."
msgstr "警告：已安装的包版本低于本转换器测试过的目标版本（{0}）。请通过 VPM 更新后重新转换。"

# ---- 转换总览 ----
msgid "Skipped: material shader is not lilToon."
msgstr "已跳过：材质用的不是 lilToon 着色器。"

msgid "Used a source-GUID suffix in the output material name to prevent same-name materials from overwriting each other in this shared output folder."
msgstr "输出材质名加了源 GUID 后缀，避免同名材质在同一个输出目录里互相覆盖。"

msgid "Create NonToon material"
msgstr "创建 NonToon 材质"

msgid "No stack trace available."
msgstr "没有可用的堆栈信息。"

msgid "Decals, dissolve, glitter, refraction, gem, audio link and animated UVs are not reproduced."
msgstr "贴花、溶解、闪烁、折射、宝石、AudioLink 与 UV 动画不会被复现。"

msgid "NonToon does not provide a one-to-one equivalent for all lilToon shadow, emission, and fur parameters. Review converted materials visually."
msgstr "NonToon 并非对所有 lilToon 的阴影、发光与毛发参数都有一一对应项，转换后请目视检查材质。"

# ---- 主色 / 贴图烘焙 ----
msgid "Referenced lilToon main texture directly because _Color is white; no base texture was baked."
msgstr "因为 _Color 是白色，直接引用了 lilToon 主贴图，没有烘焙基础贴图。"

msgid "Baked lilToon Main 1st color multiplier into the generated NonToon Base Texture."
msgstr "已把 lilToon 第 1 层主色乘算烘焙进生成的 NonToon 基础贴图。"

msgid "Detected active lilToon Main 2nd layer and baked it into the generated NonToon Base Texture."
msgstr "检测到启用的 lilToon 第 2 层主色，已烘焙进 NonToon 基础贴图。"

msgid "Detected active lilToon Main 3rd layer and baked it into the generated NonToon Base Texture."
msgstr "检测到启用的 lilToon 第 3 层主色，已烘焙进 NonToon 基础贴图。"

msgid "WARNING: Main color could not be baked; assigned _MainTex without the _Color multiplier."
msgstr "警告：主色无法烘焙，已直接指定 _MainTex（没有乘算 _Color）。"

msgid "Baked lilToon _Color into a solid NonToon base texture because _MainTex is empty."
msgstr "_MainTex 为空，已把 lilToon 的 _Color 烘焙成纯色的 NonToon 基础贴图。"

msgid "WARNING: Main color multiplier was not baked because texture baking is disabled."
msgstr "警告：贴图烘焙已关闭，主色乘算没有烘焙。"

msgid "WARNING: lilToon Alpha Mask could not be baked because Main Texture is empty."
msgstr "警告：主贴图为空，lilToon 的 Alpha 遮罩无法烘焙。"

msgid "Baked lilToon Alpha Mask into the generated NonToon Base Texture alpha channel."
msgstr "已把 lilToon 的 Alpha 遮罩烘焙进 NonToon 基础贴图的 Alpha 通道。"

msgid "WARNING: lilToon Alpha Mask requires Base Texture baking and was not copied because baking is disabled."
msgstr "警告：lilToon 的 Alpha 遮罩依赖基础贴图烘焙，因为烘焙已关闭而没有复制。"

msgid "WARNING: lilToon Alpha Mask could not be read and was not baked."
msgstr "警告：lilToon 的 Alpha 遮罩无法读取，没有烘焙。"

msgid "WARNING: lilToon Alpha Mask mode {0} is unsupported and was not baked."
msgstr "警告：lilToon 的 Alpha 遮罩模式 {0} 不支持，没有烘焙。"

msgid "WARNING: lilToon Bump 2nd Scale Mask could not be baked; Details G uses white instead."
msgstr "警告：lilToon 的第二法线缩放遮罩无法烘焙，细节 G 改用白色。"

msgid "Baked Main layers at {0}x{1}, matching the largest participating source texture (Main 1st was {2}x{3})."
msgstr "已按 {0}x{1} 烘焙主色各层，与参与烘焙的最大源贴图一致（第 1 层为 {2}x{3}）。"

msgid "WARNING: {0} layer was not baked because its texture could not be read."
msgstr "警告：{0} 层贴图无法读取，没有参与烘焙。"

msgid "WARNING: {0} blend mask could not be read; the layer was not baked."
msgstr "警告：{0} 的混合遮罩无法读取，该层没有参与烘焙。"

msgid "WARNING: {0} uses UV mode {1}; its bake is approximated with UV0."
msgstr "警告：{0} 使用 UV 模式 {1}，烘焙时按 UV0 近似处理。"

msgid "WARNING: {0} Alpha Mode {1} is unsupported and was ignored."
msgstr "警告：{0} 的 Alpha 模式 {1} 不支持，已忽略。"

msgid "WARNING: {0} decal/mirror options are not reproduced by the Base Texture bake; only its UV0 texture, color, alpha and blend mask are baked."
msgstr "警告：基础贴图烘焙不会复现 {0} 的贴花/镜像选项，只烘焙它的 UV0 贴图、颜色、Alpha 与混合遮罩。"

msgid "WARNING: {0} dissolve settings are not reproduced by the Base Texture bake."
msgstr "警告：基础贴图烘焙不会复现 {0} 的溶解设置。"

msgid "Baked {0} texture, color, blend mask and blend mode into the NonToon base texture."
msgstr "已把 {0} 的贴图、颜色、混合遮罩与混合模式烘焙进 NonToon 基础贴图。"

msgid "Generated editable Shader Core Shared Mask (.scmask). Use the Edit button in the NonToon material Inspector to change its RGBA sources."
msgstr "已生成可编辑的 Shader Core 共享遮罩（.scmask）。可在 NonToon 材质的检视面板里用编辑按钮修改它的 RGBA 来源。"

msgid "WARNING: Shader Core .scmask generation was unavailable; generated a PNG Shared Mask instead."
msgstr "警告：无法生成 Shader Core 的 .scmask，已改为生成 PNG 共享遮罩。"

msgid "WARNING: Shared Mask {0} source is not a Texture2D and cannot be stored in .scmask; it uses white instead."
msgstr "警告：共享遮罩 {0} 的来源不是 Texture2D，无法存入 .scmask，改用白色。"

msgid "WARNING: Texture '{0}' is not a Texture2D and cannot be baked."
msgstr "警告：贴图 {0} 不是 Texture2D，无法烘焙。"

msgid "WARNING: Could not read texture '{0}': {1}"
msgstr "警告：无法读取贴图 {0}：{1}"

msgid "Prepare texture for NonToon conversion"
msgstr "准备 NonToon 转换所需的贴图"

msgid "Temporarily decompressed Crunch texture '{0}' to bake it; its importer settings will be restored."
msgstr "为烘焙临时解压了 Crunch 贴图 {0}，它的导入设置稍后会还原。"

msgid "Restore texture importer after NonToon conversion"
msgstr "NonToon 转换后还原贴图导入设置"

# ---- 法线 / 粗糙度 / 高光 ----
msgid "Assigned lilToon normal map to NonToon Details A (Detail0 Normal Map)."
msgstr "已把 lilToon 法线贴图指定到 NonToon 的细节 A（Detail0 法线贴图）。"

msgid "MISSING MODULE Details: assigned normal map to NonToon base Normal Map instead of Details A."
msgstr "缺少模块 Details：法线贴图改为写入 NonToon 的基础法线贴图，而不是细节 A。"

msgid "MISSING MODULE Details: second normal map was not converted."
msgstr "缺少模块 Details：第二法线贴图没有转换。"

msgid "Assigned lilToon second normal map to NonToon Details B (Detail1 Normal Map)."
msgstr "已把 lilToon 的第二法线贴图指定到 NonToon 的细节 B（Detail1 法线贴图）。"

msgid "Generated NonToon Details RGBA mask: R=1st Normal, G=2nd Normal/Scale Mask, B/A=unused."
msgstr "已生成 NonToon 细节 RGBA 遮罩：R=第一法线，G=第二法线/缩放遮罩，B/A=未使用。"

msgid "Copied lilToon Cutoff to NonToon Cutoff."
msgstr "已复制 lilToon 的裁剪阈值到 NonToon 的裁剪阈值。"

msgid "Mapped lilToon Smoothness to NonToon physical Roughness using (1 - Smoothness)^2."
msgstr "已按 (1 - 平滑度)^2 把 lilToon 的平滑度映射到 NonToon 的物理粗糙度。"

msgid "Set NonToon Roughness to 0.5 because lilToon reflection is disabled."
msgstr "lilToon 的反射未启用，NonToon 的粗糙度设为 0.5。"

msgid "NOTICE: Visually readjust NonToon Roughness and Specular after conversion; lilToon and NonToon use different reflection models."
msgstr "提示：转换后请目视重新调整 NonToon 的粗糙度与高光，两者的反射模型不同。"

msgid "WARNING: lilToon Smoothness Texture is per-pixel and cannot be represented by NonToon's scalar Roughness."
msgstr "警告：lilToon 的平滑度贴图是逐像素的，无法用 NonToon 的标量粗糙度表示。"

msgid "WARNING: lilToon Metallic Gloss Map was not used for Roughness; Metallic is not a NonToon Roughness equivalent."
msgstr "警告：lilToon 的金属光泽贴图没有用于粗糙度，金属度并不等价于 NonToon 的粗糙度。"

msgid "MISSING MODULE Specular: reflection/specular was not converted."
msgstr "缺少模块 Specular：反射/高光没有转换。"

msgid "Disabled NonToon Specular because lilToon Reflection and Apply Specular were not both enabled."
msgstr "lilToon 的反射与「应用高光」没有同时启用，已关闭 NonToon 的高光。"

msgid "Mapped lilToon Reflection color to NonToon Specular; Smoothness is mapped to Roughness."
msgstr "已把 lilToon 的反射颜色映射到 NonToon 的高光，平滑度映射到粗糙度。"

# ---- 光照调整 ----
msgid "Copied lilToon lighting adjustments 1:1 (identical property names): {0}."
msgstr "已按 1:1 复制 lilToon 的光照调整（属性名相同）：{0}。"

msgid "NOTICE: the source had none of _AsUnlit / _LightMinLimit / _LightMaxLimit / _MonochromeLighting, so NonToon's defaults were kept."
msgstr "提示：源材质没有 _AsUnlit / _LightMinLimit / _LightMaxLimit / _MonochromeLighting，已保留 NonToon 的默认值。"

msgid "Set Shade Direction Bias to 0 so the toon shade follows the real light direction like lilToon (raise it back toward 1.5 for NonToon's original view-biased look)."
msgstr "已把「受光方向偏移」设为 0，让卡通阴影像 lilToon 一样跟随真实光照方向（想恢复 NonToon 原有的视线偏向观感，可以调回 1.5 附近）。"

# ---- 阴影 ----
msgid "MISSING MODULE Shade: lilToon shadow settings were not converted."
msgstr "缺少模块 Shade：lilToon 的阴影设置没有转换。"

msgid "Copied lilToon shadow settings to NonToon's native ShadowColor module (border/blur/strength/2nd/3rd/border colour preserved 1:1) and disabled the Shade ramp to avoid stacking."
msgstr "已把 lilToon 的阴影设置复制到 NonToon 原生的 ShadowColor 模块（边界/模糊/强度/第 2、3 层/边界颜色 1:1 保留），并关闭 Shade 渐变以免叠加。"

msgid "MISSING MODULE Shade/RimShade: color ramps could not be assigned."
msgstr "缺少模块 Shade/RimShade：颜色渐变无法指定。"

msgid "Converted lilToon shadow colors and Border/Blur thresholds to a NonToon Shade ramp."
msgstr "已把 lilToon 的阴影颜色与边界/模糊阈值转换为 NonToon 的 Shade 渐变。"

msgid "WARNING: NonToon Shade ramps have no per-pixel Shadow Strength Mask input; lilToon Shadow Strength Mask was not copied."
msgstr "警告：NonToon 的明暗渐变没有逐像素的阴影强度遮罩输入，lilToon 的阴影强度遮罩没有复制。"

msgid "WARNING: NonToon Shade ramps have no per-pixel Shadow Border Mask input; lilToon Shadow Border Mask was not copied."
msgstr "警告：NonToon 的明暗渐变没有逐像素的阴影边界遮罩输入，lilToon 的阴影边界遮罩没有复制。"

msgid "WARNING: NonToon Shade ramps have no per-pixel Shadow Blur Mask input; lilToon Shadow Blur Mask was not copied."
msgstr "警告：NonToon 的明暗渐变没有逐像素的阴影模糊遮罩输入，lilToon 的阴影模糊遮罩没有复制。"

# ---- 共享遮罩 ----
msgid "Shared mask channels: R=MatCap Add Blend Mask, G=MatCap Multiply Blend Mask, B=RimShade Mask, A=shared white mask for Specular/RimLight/Lighten/HairSpecular."
msgstr "共享遮罩通道：R=MatCap 加算混合遮罩，G=MatCap 正片叠底混合遮罩，B=边缘阴影遮罩，A=供高光/边缘光/提亮/头发高光共用的白色遮罩。"

msgid "Mapped lilToon Emission Blend Mask to Shared Mask {0} and assigned it to NonToon Lighten."
msgstr "已把 lilToon 的发光混合遮罩映射到共享遮罩 {0}，并指定给 NonToon 的提亮。"

msgid "WARNING: Emission Blend Mask uses Shared Mask A because R/G/B are occupied; Specular, RimLight and HairSpecular may also be limited by this mask."
msgstr "警告：因为 R/G/B 已被占用，发光混合遮罩改用共享遮罩 A；高光、边缘光与头发高光也可能受这个遮罩限制。"

# ---- 毛发 ----
msgid "WARNING: The installed NonToonFur shader has no Fur Noise properties; fur-specific values were not converted."
msgstr "警告：已安装的 NonToonFur 着色器没有毛发噪声属性，毛发相关参数没有转换。"

msgid "Mapped lilToon Fur Noise Mask and texture tiling to NonToonFur Fur Noise / Noise Tiling ({0})."
msgstr "已把 lilToon 的毛发噪声遮罩与贴图平铺映射到 NonToonFur 的毛发噪声/噪声平铺（{0}）。"

msgid "WARNING: The installed NonToonFur shader has no Noise Tiling property; only the Fur Noise Mask was copied."
msgstr "警告：已安装的 NonToonFur 没有噪声平铺属性，只复制了毛发噪声遮罩。"

msgid "WARNING: NonToonFur Fur Noise has one tiling value only; lilToon non-uniform Noise scale and offset were approximated."
msgstr "警告：NonToonFur 的毛发噪声只有一个平铺值，lilToon 的非等比缩放与偏移已近似处理。"

msgid "Mapped lilToon Fur Layer Num to NonToonFur Subdivision ({0})."
msgstr "已把 lilToon 的毛发层数映射到 NonToonFur 的细分（{0}）。"

msgid "Mapped lilToon Fur Vector direction and length to NonToonFur Fur Vector."
msgstr "已把 lilToon 的毛发方向与长度映射到 NonToonFur 的毛发向量。"

msgid "WARNING: NonToonFur has no Fur Vector Texture or vertex-color direction input; detailed lilToon fur direction was approximated with Fur Vector."
msgstr "警告：NonToonFur 没有毛发方向贴图与顶点色方向输入，lilToon 的精细毛发方向已用毛发向量近似。"

msgid "WARNING: NonToonFur has no lilToon-equivalent Fur Gravity or Randomize control; these fur direction modifiers were not converted."
msgstr "警告：NonToonFur 没有等价于 lilToon 的毛发重力与随机化控制，这些毛发方向修饰没有转换。"

# ---- 描边 ----
msgid "WARNING: Outline is unavailable in the installed NonToon shader."
msgstr "警告：已安装的 NonToon 着色器没有描边功能。"

msgid "Mapped lilToon Outline color and width to NonToon; vertex-color outline={0}."
msgstr "已把 lilToon 的描边颜色与宽度映射到 NonToon；顶点色描边={0}。"

msgid "NOTICE: NonToon uses vertex RGB as the outline direction and vertex A for Z Offset; lilToon vertex-color outline modes are approximated."
msgstr "提示：NonToon 用顶点 RGB 作为描边方向、顶点 A 作为 Z 偏移，lilToon 的顶点色描边模式为近似处理。"

msgid "WARNING: NonToon standard Outline has no equivalent for lilToon Outline Texture, Width Mask, or Z Bias; those settings were not copied."
msgstr "警告：NonToon 的标准描边没有 lilToon 的描边贴图、宽度遮罩与 Z 偏移对应项，这些设置没有复制。"

# ---- MatCap ----
msgid "MISSING MODULE MatCaps: matcap was not converted."
msgstr "缺少模块 MatCaps：MatCap 没有转换。"

msgid "NOTICE: Visually readjust converted MatCaps; lilToon and NonToon use different matcap UV, lighting, mask, and blend behavior, so the material appearance can change significantly."
msgstr "提示：转换后的 MatCap 请目视重调，两者的 MatCap UV、受光、遮罩与混合方式都不同，观感可能差异明显。"

msgid "Mapped one lilToon Add MatCap and one Multiply MatCap to their matching NonToon slots."
msgstr "已把 lilToon 的一个加算 MatCap 与一个正片叠底 MatCap 映射到对应的 NonToon 槽位。"

msgid "WARNING: Both lilToon MatCaps are not one Add and one Multiply pair; converted 1st MatCap only, using its closest NonToon blend slot."
msgstr "警告：lilToon 的两个 MatCap 并非一加算一正片叠底，只转换了第 1 个 MatCap，并使用最接近的 NonToon 混合槽位。"

msgid "{0} mapped to NonToon {1} with Shared Mask {2}; copied RGB tint without converting lilToon opacity into color intensity."
msgstr "已把 {0} 映射到 NonToon 的 {1}（共享遮罩 {2}）；只复制了 RGB 着色，没有把 lilToon 的不透明度换算成颜色强度。"

msgid "NOTICE: {0} lilToon opacity {1} has no direct NonToon MatCap control and was not converted; visually adjust the MatCap color or mask after conversion."
msgstr "提示：{0} 的 lilToon 不透明度 {1} 在 NonToon 里没有直接的 MatCap 控制项，没有转换；转换后请目视调整 MatCap 颜色或遮罩。"

msgid "WARNING: {0} blend mode {1} was approximated as NonToon {2}."
msgstr "警告：{0} 的混合模式 {1} 已近似为 NonToon 的 {2}。"

# ---- 边缘光 / 边缘阴影 / 背光 ----
msgid "MISSING MODULE RimLight: rim light was not converted."
msgstr "缺少模块 RimLight：边缘光没有转换。"

msgid "Mapped rim light Border/Blur/Fresnel Power to NonToon RimLight Range ({0}–{1})."
msgstr "已把边缘光的边界/模糊/菲涅尔映射到 NonToon 的边缘光范围（{0}–{1}）。"

msgid "MISSING MODULE RimShade: rim shade was not converted."
msgstr "缺少模块 RimShade：边缘阴影没有转换。"

msgid "Converted lilToon rim-shade color and Border/Blur/Fresnel Power to a NonToon RimShade ramp."
msgstr "已把 lilToon 的边缘阴影颜色与边界/模糊/菲涅尔转换为 NonToon 的 RimShade 渐变。"

msgid "WARNING: Installed NonToon shader has no Backlight properties; lilToon Backlight was not converted."
msgstr "警告：已安装的 NonToon 着色器没有背光属性，lilToon 的背光没有转换。"

msgid "Mapped lilToon Backlight Border directly to NonToon Backlight Range and inverse Blur to Backlight Sharpness (toon strength)."
msgstr "已把 lilToon 的背光边界直接映射到 NonToon 的背光范围，并把模糊反向后映射到背光锐度（卡通强度）。"

msgid "WARNING: NonToon Backlight controls light shaping only; lilToon Backlight color and color texture were not reproduced."
msgstr "警告：NonToon 的背光只控制受光形状，lilToon 的背光颜色与颜色贴图没有复现。"

# ---- 距离淡出 ----
msgid "MISSING MODULE DistanceFade: distance fade was not converted."
msgstr "缺少模块 DistanceFade：距离淡出没有转换。"

msgid "Mapped lilToon Distance Fade start/end in reverse order to preserve its fade direction in NonToon; copied strength."
msgstr "为保持淡出方向，lilToon 距离淡出的起点/终点已按相反顺序映射到 NonToon；强度已复制。"

msgid "WARNING: NonToon Distance Fade fades to black camera depth only; lilToon fade color, object-depth mode, and rim fade are not equivalent."
msgstr "警告：NonToon 的距离淡出只按相机深度淡出到黑色，lilToon 的淡出色、物体深度模式与边缘淡出并不等价。"

# ---- 头发高光 ----
msgid "MISSING MODULE HairSpecular: anisotropy was not converted."
msgstr "缺少模块 HairSpecular：各向异性没有转换。"

msgid "Mapped lilToon anisotropy strength, shift and tangent width to an approximate NonToon Hair Specular ramp."
msgstr "已把 lilToon 的各向异性强度、偏移与切线宽度近似映射到 NonToon 的头发高光渐变。"

# ---- 发光 ----
msgid "Copied lilToon emission 1:1 to NonToon's native Emission module (colour / map / blend / blend mask / main strength / blend mode)."
msgstr "已把 lilToon 的发光 1:1 复制到 NonToon 原生的 Emission 模块（颜色/贴图/混合/混合遮罩/受主色影响/混合模式）。"

msgid " Source material had no "
msgstr "；源材质没有以下属性："

msgid "; NonToon defaults were kept for those."
msgstr "，这些项保留了 NonToon 的默认值。"

msgid "WARNING: lilToon 2nd emission (_UseEmission2nd) has no NonToon equivalent and was not converted."
msgstr "警告：lilToon 的第二发光（_UseEmission2nd）在 NonToon 里没有对应项，没有转换。"

msgid "WARNING: lilToon {0} has no NonToon equivalent and was not converted."
msgstr "警告：lilToon 的 {0} 在 NonToon 里没有对应项，没有转换。"

msgid "MISSING MODULE Lighten: emission was not converted."
msgstr "缺少模块 Lighten：发光没有转换。"

msgid "Skipped NonToon Lighten because lilToon Emission has zero effective strength after Color Alpha and Blend were applied."
msgstr "lilToon 的发光在乘算颜色 Alpha 与混合强度后有效强度为 0，已跳过 NonToon 的提亮。"

msgid "Mapped lilToon Emission Blend Mask to NonToon Lighten Shared Mask {0}."
msgstr "已把 lilToon 的发光混合遮罩映射到 NonToon 提亮的共享遮罩 {0}。"

msgid "WARNING: Emission Blend Mask requires texture baking; the Shared Mask was not generated, so Lighten uses its default mask."
msgstr "警告：发光混合遮罩需要烘焙贴图，共享遮罩没有生成，提亮会使用默认遮罩。"

msgid "WARNING: NonToon Lighten has no colored emission texture; only lilToon emission intensity was mapped."
msgstr "警告：NonToon 的提亮没有彩色发光贴图，只映射了 lilToon 的发光的强度。"

msgid "Mapped lilToon grayscale emission effective strength (RGB × Alpha × Blend = {0}) to NonToon Lighten."
msgstr "已把 lilToon 灰度发光的有效强度（RGB × Alpha × 混合 = {0}）映射到 NonToon 的提亮。"

# ---- 渲染模式 / 模板 ----
msgid "Mapped lilToon rendering mode to NonToon {0}."
msgstr "已把 lilToon 的渲染模式映射到 NonToon 的 {0}。"

msgid "WARNING: lilToon transparent/refraction/gem rendering is approximated as NonToon transparent."
msgstr "警告：lilToon 的半透明/折射/宝石渲染已近似为 NonToon 的半透明。"

msgid "Mapped lilToon main/outline Stencil Ref, Comp and Pass to NonToon."
msgstr "已把 lilToon 主材质/描边的模板参考值、比较函数与通过操作映射到 NonToon。"

msgid "WARNING: NonToon has no matching Stencil read/write mask or Fail/ZFail setting; those lilToon values were not converted."
msgstr "警告：NonToon 没有对应的模板读写遮罩与 Fail/ZFail 设置，这些 lilToon 值没有转换。"

